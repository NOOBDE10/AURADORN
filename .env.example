# Copy to .env for local development. On Netlify, set these under
# Site configuration → Environment variables.

# --- Firebase web config (public; Project settings → General → Your apps) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Cloudinary: product photo uploads from admin (unsigned upload preset) ---
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# --- Server only (Netlify Functions). NEVER prefix these with VITE_ ---
# Service-account JSON (raw or base64) from Project settings → Service accounts
FIREBASE_SERVICE_ACCOUNT=
# Gmail account + 16-letter app password used to send new-order emails
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Fallback recipient if not set in Admin → Settings
ORDER_ALERT_EMAIL=
