{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Jewellery product catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "price": { "type": "number" },
        "discountPrice": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discountPercentage": { "type": "number" },
        "category": { "type": "string", "maxLength": 100 },
        "subCategory": { "type": "string", "maxLength": 100 },
        "stock": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "draft", "out_of_stock"] },
        "isFeatured": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "images": { "type": "array" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "price", "category", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category classification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "image": { "type": "string", "maxLength": 2000 },
        "itemCount": { "type": "number" }
      },
      "required": ["name", "slug"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 500 },
        "city": { "type": "string", "maxLength": 100 },
        "area": { "type": "string", "maxLength": 150 },
        "postalCode": { "type": "string", "maxLength": 30 },
        "notes": { "type": "string", "maxLength": 1000 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "deliveryCharge": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["customerName", "phone", "email", "address", "city", "items", "totalAmount", "status", "paymentMethod"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback and ratings for jewellery",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerEmail": { "type": "string", "maxLength": 150 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["approved", "pending"] },
        "createdAt": { "type": "string" }
      },
      "required": ["productId", "customerName", "rating", "comment"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store configuration and policies",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "maxLength": 100 },
        "logo": { "type": "string", "maxLength": 2000 },
        "phone": { "type": "string", "maxLength": 50 },
        "whatsappNumber": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 500 },
        "deliveryCharge": { "type": "number" },
        "freeDeliveryThreshold": { "type": "number" }
      },
      "required": ["brandName", "email", "whatsappNumber"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Registered customer profile and preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "wishlist": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin", "superadmin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "All public and admin manageable products"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Store categories"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product customer reviews"
    },
    "/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Global store business configurations and policies"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer profiles and wishlist"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Authorized admin users lookup"
    }
  }
}
