rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Admins are listed in /admins/{uid}. That collection can only be written with the
    // service account (scripts/setup-firebase.mjs), never from the browser.
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /admins/{adminId} {
      // A signed-in user may check whether they themselves are an admin.
      allow get: if isSignedIn() && request.auth.uid == adminId;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(productId);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(categoryId);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders are created only by the server function (service account).
    // Admins manage all orders; a signed-in customer can read their own orders.
    match /orders/{orderId} {
      allow read, update, delete: if isAdmin();
      allow read: if isSignedIn() && resource.data.customerId == request.auth.uid;
    }

    // Customer profiles: only the customer themselves (or an admin) can read/write.
    match /customers/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'name', 'email', 'phone', 'defaultAddress', 'wishlist', 'createdAt', 'updatedAt'])
        && request.resource.data.id == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 150
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30))
        && (!('wishlist' in request.resource.data) || (request.resource.data.wishlist is list && request.resource.data.wishlist.size() <= 200))
        && (!('defaultAddress' in request.resource.data) || request.resource.data.defaultAddress is map);
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isValidId(reviewId)
        && request.resource.data.status == 'pending'
        && request.resource.data.verifiedPurchase == false
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 2000
        && request.resource.data.productId is string
        && exists(/databases/$(database)/documents/products/$(request.resource.data.productId));
      allow update, delete: if isAdmin();
    }

    match /subscribers/{subscriberId} {
      allow create: if isValidId(subscriberId)
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 150
        && request.resource.data.keys().hasOnly(['id', 'email', 'subscribedAt', 'source', 'active']);
      allow read, delete: if isAdmin();
    }
  }
}
